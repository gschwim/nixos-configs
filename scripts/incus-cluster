#!/usr/bin/env bash
# incus-cluster — manage this host's Incus cluster membership from the central
# topology (lib/incus-clusters.nix), surfaced by the NixOS incus module at
# /etc/incus-cluster.json.
#
# Subcommands:
#   incus-cluster status            Show the topology descriptor + cluster list.
#   incus-cluster enable            SEED only: `incus cluster enable` in place
#                                   (non-destructive; keeps existing data).
#   incus-cluster token <member>    Mint a fresh join token (run on/against the
#                                   seed). Tokens are single-use and short-lived.
#   incus-cluster join [--seed H]   MEMBER, ONE-TIME DESTRUCTIVE: SSH the seed
#                                   to mint a token, reset local Incus, and
#                                   re-init this node as a cluster member.
#   incus-cluster leave             Gracefully remove this host from the cluster.
#
# Why a helper and not pure preseed: Incus join tokens are single-use and
# expire (~3h) and the NixOS preseed is one-shot, so the join step is inherently
# imperative. Everything it needs (seed, addresses, per-member config) comes
# from the central topology via the descriptor — no per-host token secrets.
#
# SSH: the token is minted on the seed over SSH as your admin user (the one
# carrying the CA-signed key), defaulting to $SUDO_USER then $USER. Override
# with INCUS_CLUSTER_SSH_USER. If that user can't reach the Incus socket on the
# seed, set INCUS_CLUSTER_REMOTE="sudo " to prefix the remote incus call.

set -euo pipefail

DESC=/etc/incus-cluster.json
SSH_USER="${INCUS_CLUSTER_SSH_USER:-${SUDO_USER:-$USER}}"
REMOTE_PREFIX="${INCUS_CLUSTER_REMOTE:-}"

die() { echo "incus-cluster: $*" >&2; exit 1; }

# Run SSH as the invoking (non-root) user even when the script is called via
# sudo — root's agent/keys won't carry the CA-signed user key the seed trusts.
_ssh() {
  if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
    sudo -u "$SUDO_USER" ssh "$@"
  else
    ssh "$@"
  fi
}

need_desc() {
  [ -r "$DESC" ] || die "$DESC not found — this host isn't configured for clustering (set my.services.incus.cluster.enable)."
}

d() { jq -r "$1" "$DESC"; }

# True when this daemon is already a cluster member.
clustered() {
  incus query /1.0/cluster 2>/dev/null | jq -e '.enabled == true' >/dev/null 2>&1
}

# Pull the (long base64) token out of `incus cluster add` output.
extract_token() { grep -oE '[A-Za-z0-9+/=_-]{60,}' | tail -n1; }

cmd_status() {
  need_desc
  echo "== topology ($DESC) =="
  jq . "$DESC"
  echo
  if clustered; then
    echo "== incus cluster list =="
    incus cluster list
  else
    echo "(this node is not yet a cluster member)"
  fi
}

cmd_enable() {
  need_desc
  local role name
  role=$(d .role); name=$(d .name)
  [ "$role" = "seed" ] || die "this host is role '$role' of cluster '$name', not the seed — run 'join' instead."
  if clustered; then
    echo "incus-cluster: '$name' already enabled here; nothing to do."
    incus cluster list
    return 0
  fi
  echo "incus-cluster: enabling cluster '$name' on seed $(hostname) ($(d .address))…"
  incus cluster enable "$(hostname)"
  incus cluster list
}

cmd_token() {
  need_desc
  local member="${1:-}"
  [ -n "$member" ] || die "usage: incus-cluster token <member>"
  clustered || die "not a cluster yet — run 'incus-cluster enable' on the seed first."
  incus cluster add "$member" | extract_token
}

cmd_join() {
  need_desc
  local seed_override=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --seed)   seed_override="${2:?--seed needs a host}"; shift 2 ;;
      --seed=*) seed_override="${1#*=}"; shift ;;
      *) die "join: unknown argument: $1" ;;
    esac
  done

  local role name self self_addr seed seed_addr
  role=$(d .role); name=$(d .name); self=$(hostname)
  self_addr=$(d .address)
  seed=${seed_override:-$(d .seed)}
  seed_addr=$(jq -r --arg s "$seed" '.members[$s] // empty' "$DESC")
  [ -n "$seed_addr" ] || die "no address for seed '$seed' in $DESC (use --seed or fix the topology)."
  [ "$seed" != "$self" ] || die "this host IS the seed of '$name' — run 'incus-cluster enable', not 'join'."

  cat <<EOF
About to JOIN cluster '$name' via seed $seed ($seed_addr).

  !!! THIS WIPES THIS NODE'S LOCAL INCUS STATE !!!
  All local instances/images/profiles on $self are destroyed; the node then
  adopts the cluster's configuration. Export anything worth keeping first
  (incus export ...).

  this node : $self ($self_addr:8443)
  token via : ssh $SSH_USER@$seed_addr ${REMOTE_PREFIX}incus cluster add $self
EOF
  read -rp "Type the cluster name to confirm ($name): " ans
  [ "$ans" = "$name" ] || die "confirmation mismatch — aborted, nothing changed."

  echo "==> Minting a fresh join token on the seed…"
  local token
  token=$(_ssh "$SSH_USER@$seed_addr" "${REMOTE_PREFIX}incus cluster add $self" | extract_token)
  [ -n "$token" ] || die "failed to obtain a join token from $seed (check SSH access and that the seed is clustered)."

  # Join-time member_config: ALL per-member keys incus prompts for in interactive
  # `incus admin init` — the complete set is mandatory. For our cluster that's
  # storage-pool default {source, zfs.pool_name} + network infra100
  # bridge.external_interfaces. The set must be COMPLETE: an incomplete storage
  # member_config (e.g. omitting zfs.pool_name) breaks the whole
  # "initialize storage pools and networks" phase and surfaces as a misleading
  # "Network not found" on the first network. The descriptor (built in
  # modules/services/incus.nix) already carries the full set.
  local member_yaml
  member_yaml=$(jq -r '
    .memberConfig[]
    | "    - entity: \(.entity)\n      name: \(.name)\n      key: \(.key)\n      value: \"\(.value)\""
  ' "$DESC")

  # ZFS pool source (e.g. rpool/incus) the member will reuse. incus refuses a
  # NON-EMPTY dataset as a pool source on join, so we empty it below.
  local pool
  pool=$(jq -r '.memberConfig[] | select(.entity == "storage-pool" and .key == "source") | .value' "$DESC" | head -1)
  [ -n "$pool" ] && [ "$pool" != "null" ] || die "could not determine ZFS storage pool source from $DESC"

  # The cluster's managed bridge names (from the seed — incusbr0/prod/infra100…).
  # We delete any LEFTOVER local devices with these names before joining: a
  # stale unmanaged bridge from this node's prior standalone preseed makes the
  # join's network creation roll back and fail with "Network not found". Host
  # trunk subifs (dong0.100, enp3s0.100) are type=vlan/managed=NO on the seed, so
  # they never appear here and are never touched. SSH is already proven working
  # (we just minted the token over it).
  local cluster_bridges
  cluster_bridges=$(_ssh "$SSH_USER@$seed_addr" "${REMOTE_PREFIX}incus network list --format csv" 2>/dev/null \
    | awk -F, '$2 == "bridge" { print $1 }')

  echo "==> Resetting local Incus so it can re-init as a member (needs root)…"
  echo "  incus state dir : /var/lib/incus"
  echo "  ZFS pool source : $pool"

  # 1. Stop the daemon completely so nothing holds the pool/zvols open.
  sudo systemctl stop incus.service incus.socket 2>/dev/null || true

  # 2. incus-preseed.service is bound to incus.service (wantedBy + bindsTo) with
  #    NO condition guard, so it re-runs on every incus start and would
  #    pre-create pools/networks before our join preseed (conflict). Mask it for
  #    this boot; unmasked again once the join succeeds.
  sudo systemctl mask --runtime incus-preseed.service 2>/dev/null || true

  # 2b. Kill leftover incus dnsmasq and delete the leftover incus bridge devices.
  #     Stopping incus.service does NOT tear these down (the journal shows
  #     dnsmasq "remains running" and the bridges survive until a reboot), and a
  #     stale incusbr0 device makes the join fail with "Network not found". Only
  #     the cluster's managed bridges are deleted; host trunks (dong0.100) are not.
  sudo pkill -f 'dnsmasq.*var/lib/incus' 2>/dev/null || true
  local br
  for br in $cluster_bridges; do
    if ip -br link show "$br" >/dev/null 2>&1; then
      echo "    ip link delete $br"
      sudo ip link delete "$br" 2>/dev/null || true
    fi
  done

  # 3. Unmount every incus mount, deepest-first, filtered by mountpoint PATH so
  #    we also sweep stale mounts left at /var/lib/incus.pre-join.* by earlier
  #    attempts. awk exits 0 on no-match (grep would exit 1 and, under
  #    `set -e -o pipefail`, silently kill the script right here).
  local m
  while IFS= read -r m; do
    echo "    umount -l $m"
    sudo umount -l "$m" 2>/dev/null || true
  done < <(awk '$2 ~ "^/var/lib/incus" {print $2}' /proc/mounts | sort -r)

  # 4. Free any process still holding a zvol (VM block device) open, then
  #    destroy the pool with all children/clones and recreate it empty.
  if sudo zfs list "$pool" >/dev/null 2>&1; then
    local v
    while IFS= read -r v; do
      [ -b "/dev/zvol/$v" ] || continue
      echo "    fuser -km /dev/zvol/$v"
      sudo fuser -km "/dev/zvol/$v" 2>/dev/null || true
    done < <(sudo zfs list -rHt volume -o name "$pool" 2>/dev/null)
    sleep 2
    echo "  Destroying and recreating $pool…"
    sudo zfs destroy -Rf "$pool"
  fi
  sudo zfs create "$pool"

  # 5. Wipe the incus state dir (DB + leftover storage-pool dirs) and any
  #    backups from earlier failed runs so nothing pre-exists for the join.
  sudo rm -rf /var/lib/incus /var/lib/incus.pre-join.*
  sudo mkdir -p /var/lib/incus

  # 6. Start only the socket; the join preseed socket-activates incusd with an
  #    empty database (no standalone pre-init race).
  sudo systemctl start incus.socket

  echo "==> Joining the cluster…"
  local join_preseed
  join_preseed=$(cat <<EOF
cluster:
  enabled: true
  server_name: $self
  server_address: $self_addr:8443
  cluster_token: $token
  member_config:
$member_yaml
EOF
)
  printf '%s\n' "$join_preseed" | grep -v cluster_token || true   # echo, token redacted
  if ! printf '%s\n' "$join_preseed" | sudo incus admin init --preseed; then
    echo "---- last 40 lines of incus journal ----" >&2
    sudo journalctl -u incus.service --no-pager -n 40 >&2 || true
    echo "----------------------------------------" >&2
    die "incus admin init --preseed failed (see error above). Local state was reset; fix the cause and re-run 'incus-cluster join'."
  fi

  # Verify membership actually took before declaring success.
  clustered || die "join preseed ran without error but this node is NOT a cluster member (incus query /1.0/cluster shows disabled). Check the seed's 'incus cluster list'."

  # Per-member network trunk(s) were supplied in the join member_config, so the
  # infra100 bridge already has its external interface. Nothing to apply here.

  # Join succeeded — re-enable the preseed service. Future preseed runs (e.g.
  # after nixos-rebuild) update existing resources, a no-op for most keys.
  sudo systemctl unmask --runtime incus-preseed.service 2>/dev/null || true

  echo "==> Joined '$name'. Cluster members:"
  incus cluster list
}

cmd_leave() {
  need_desc
  local self name
  self=$(hostname); name=$(d .name)
  clustered || die "not a cluster member; nothing to leave."
  read -rp "Remove $self from cluster '$name'? (y/N) " ans
  case "$ans" in [Yy]*) ;; *) echo "Aborted."; exit 0 ;; esac
  incus cluster remove "$self"
  echo "incus-cluster: removed $self from '$name'."
}

case "${1:-status}" in
  status)     shift; cmd_status "$@" ;;
  enable)     shift; cmd_enable "$@" ;;
  token)      shift; cmd_token "$@" ;;
  join)       shift; cmd_join "$@" ;;
  leave)      shift; cmd_leave "$@" ;;
  -h|--help)  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)          die "unknown subcommand: $1 (try: status, enable, token, join, leave)" ;;
esac
